---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchData } from '../lib/fetchData';
import { fetchLog, formatDate } from '../lib/logbook';
import type { Building } from '../lib/site';
import 'katex/dist/katex.min.css';

// Every logbook entry of the projects in data/building.json, newest first per project
const items = await fetchData<Building[]>('building.json');
const projects = await Promise.all(
  items.filter(item => item.log).map(async item => ({ ...item, entries: await fetchLog(item.log!) })),
);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<BaseLayout
  title="Logbook — CoMaE"
  description="Lab notes from the projects I'm working on: one entry per session, what I did and what I learned, from Raman spectra and Poisson noise to training my first models."
>
  <main class="px-5 pt-16 pb-24 md:pt-24">
    <div class="mx-auto max-w-3xl">
      <a href="/#building" class="text-[15px] text-muted hover:text-zinc-200 transition-colors">← CoMaE</a>
      <h1 class="mt-12 text-4xl md:text-5xl font-medium leading-tight text-zinc-50 mb-4">Lab notes</h1>
      <p class="text-lg leading-relaxed text-zinc-400 max-w-xl mb-16">
        One entry per session on what I'm building: what I did, what went wrong and what I learned.
      </p>

      {projects.map(project => (
        <section id={slug(project.title)} class="mb-20 last:mb-0">
          <div class="border-b border-zinc-800 pb-6 mb-10">
            <h2 class="text-2xl md:text-3xl font-semibold text-zinc-50 mb-1">{project.title}</h2>
            <p class="text-[15px] text-muted mb-4">
              In progress since {project.started}
              {project.repo && (
                <>
                  <span aria-hidden="true"> · </span>
                  <a href={project.repo} target="_blank" rel="noopener noreferrer" class="link">Code on GitHub ↗</a>
                </>
              )}
            </p>
            <p class="text-xl italic leading-snug text-zinc-200">{project.question}</p>
          </div>

          {project.entries.length > 0 ? (
            <ol class="space-y-14">
              {project.entries.map(entry => (
                <li id={`${slug(project.title)}-${entry.date}`} class="grid md:grid-cols-[8rem_1fr] gap-1 md:gap-8">
                  <time datetime={entry.date} class="text-[15px] text-muted md:pt-1">{formatDate(entry.date)}</time>
                  <article>
                    <h3 class="text-xl font-semibold text-zinc-100 mb-3">{entry.title}</h3>
                    <div class="log-body leading-relaxed text-zinc-300" set:html={entry.html} />
                  </article>
                </li>
              ))}
            </ol>
          ) : (
            <p class="text-muted">No entries yet.</p>
          )}
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
