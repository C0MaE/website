---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lost in space — CoMaE" description="This page doesn't exist (anymore)." noindex>
  <main class="relative min-h-screen overflow-hidden px-5 pt-24 pb-6 lg:py-0 lg:flex lg:items-center">
    <div class="relative z-10 page-container lg:py-24 pointer-events-none">
      <p class="font-mono text-xs text-muted tracking-wider mb-6">404 · Page not found</p>
      <h1 class="font-serif text-7xl sm:text-8xl md:text-9xl leading-[0.9] text-zinc-50 mb-6">
        Escaped <em class="text-accent-light">orbit.</em>
      </h1>
      <p class="text-zinc-300 text-lg md:text-xl leading-relaxed max-w-md mb-8 lg:mb-10">
        This page reached escape velocity — or never existed. The probe is about to follow. Can you catch it?
      </p>
      <div class="flex flex-wrap items-center gap-3 pointer-events-auto">
        <a href="/" class="px-5 py-2.5 bg-zinc-100 hover:bg-white text-zinc-950 rounded-full font-medium text-sm transition-colors">
          ← Back home
        </a>
        <a href="/#projects" class="px-5 py-2.5 border border-zinc-700 hover:border-zinc-400 text-zinc-300 hover:text-white rounded-full text-sm transition-colors">
          See my projects
        </a>
      </div>
    </div>

    <!-- Mini game: brake the probe from its hyperbolic flyby into an orbit -->
    <div id="game" class="relative h-[26rem] -mx-5 mt-4 lg:m-0 lg:absolute lg:inset-y-0 lg:right-0 lg:left-[46%] lg:h-auto">
      <canvas id="game-canvas" class="absolute inset-0 w-full h-full touch-none select-none cursor-crosshair" role="img" aria-label="Mini game: hold to fire the probe's retro-thrusters and brake it into an orbit around the planet"></canvas>

      <div id="game-msg" class="absolute inset-x-0 top-4 lg:top-[13%] px-6 text-center pointer-events-none opacity-0 transition-opacity duration-300" aria-live="polite" inert>
        <p class="font-serif text-3xl md:text-4xl text-zinc-50" data-title></p>
        <p class="mt-1 text-sm text-zinc-400 max-w-xs mx-auto leading-relaxed" data-text></p>
        <button type="button" class="mt-4 px-4 py-2 rounded-full border border-zinc-700 hover:border-zinc-400 text-zinc-300 hover:text-white text-sm transition-colors" data-again>Try again</button>
      </div>

      <div class="absolute inset-x-0 bottom-4 lg:bottom-[12%] flex flex-col items-center gap-2 pointer-events-none font-mono text-[11px]">
        <p id="game-hint" class="text-muted transition-opacity duration-500">Hold to fire the retro-thrusters</p>
        <div class="flex items-center gap-3 text-zinc-400">
          <span>FUEL</span>
          <span class="w-24 h-1 rounded-full bg-zinc-800 overflow-hidden"><span id="game-fuel" class="block h-full w-full bg-amber-400 origin-left"></span></span>
          <span id="game-ecc" class="w-44 whitespace-nowrap">&nbsp;</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { launch, step, elements, predict, fateOf, PLANET_R, CRASH_R, VIEW_R, LOST_R, FUEL, type Probe, type Fate } from '../lib/probe';

  const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const msg = document.getElementById('game-msg')!;
  const again = msg.querySelector<HTMLButtonElement>('[data-again]')!;
  const hint = document.getElementById('game-hint')!;
  const fuelBar = document.getElementById('game-fuel')!;
  const ecc = document.getElementById('game-ecc')!;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  const SUB = 1 / 240;                          // physics substep
  const FATE_COLOR: Record<Fate, string> = { orbit: '#34d399', escape: '#fbbf24', crash: '#f87171' };
  const FATE_LABEL: Record<Fate, string> = { orbit: 'captured', escape: 'escaping', crash: 'collision course' };

  type State = 'waiting' | 'flying' | 'captured' | 'crashed' | 'lost';
  let state: State = 'waiting';
  let probe: Probe = launch();
  let trail: { x: number; y: number }[] = [];
  let burning = false, touched = false, settled = 0, age = 0;
  let boom: { x: number; y: number; t: number } | null = null;
  let w = 0, h = 0, dpr = 1, scale = 1, last = 0;

  hint.textContent = `${coarse ? 'Press and hold' : 'Hold the mouse button or Space'} to brake · let go when the line turns green`;

  function resize() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    const r = canvas.getBoundingClientRect();
    w = r.width; h = r.height;
    canvas.width = w * dpr; canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    scale = (Math.min(w, h) / 2 / VIEW_R) * 0.94;
  }
  const sx = (x: number) => w / 2 + x * scale;
  const sy = (y: number) => h / 2 - y * scale;

  function say(title: string, text: string, button: string) {
    msg.querySelector('[data-title]')!.textContent = title;
    msg.querySelector('[data-text]')!.textContent = text;
    again.textContent = button;
    msg.style.opacity = '1';
    msg.inert = false;
    again.style.pointerEvents = 'auto';
  }
  // Hidden messages must not catch clicks or keyboard focus
  function hush() { msg.style.opacity = '0'; msg.inert = true; again.style.pointerEvents = 'none'; }

  function reset() {
    probe = launch(); trail = []; boom = null;
    state = 'flying'; touched = false; settled = 0; age = 0; burning = false;
    hush();
  }

  function end(next: State) {
    state = next; burning = false;
    const { e } = elements(probe);
    if (next === 'captured') {
      const rating = e < 0.15 ? 'Nearly circular — textbook.' : e < 0.5 ? 'A solid, stable orbit.' : 'Wobbly, but it counts.';
      say('Back in orbit.', `${rating} e = ${e.toFixed(2)}, ${Math.round((probe.fuel / FUEL) * 100)} % fuel left.`, 'Fly again');
    } else if (next === 'crashed') {
      boom = { x: probe.x, y: probe.y, t: 0 };
      say('Burned up.', 'Braking too early or for too long drags its closest approach into the atmosphere. Let go once the line turns green.', 'Try again');
    } else if (next === 'lost') {
      if (!touched) { setTimeout(reset, 600); return; }   // nobody played: just send the next one
      say('It got away.', probe.fuel > 0.5
        ? 'Not enough braking. Hold until the line turns green, right as it swings past the planet.'
        : 'Out of fuel. Brake close to the planet, where every bit of thrust counts most (Oberth effect).', 'Try again');
    }
  }

  function update(dt: number) {
    age += dt;
    if (boom) boom.t += dt;
    if (state === 'waiting' || state === 'crashed') return;
    const n = Math.ceil(dt / SUB);
    for (let i = 0; i < n; i++) {
      step(probe, dt / n, burning && state === 'flying');
      if (state !== 'flying') continue;   // after the verdict it just coasts on
      const r = Math.hypot(probe.x, probe.y);
      if (r < CRASH_R) return end('crashed');
      if (r > LOST_R && probe.x * probe.vx + probe.y * probe.vy > 0) return end('lost');   // on its way out
    }
    trail.push({ x: probe.x, y: probe.y });
    if (trail.length > 140) trail.shift();
    // Captured once the predicted orbit stays good for a moment without thrust;
    // lost as soon as the tank is empty and nothing can bring it back
    const fate = fateOf(probe);
    if (state === 'flying' && touched && !burning && (fate === 'orbit' || (fate === 'escape' && probe.fuel <= 0))) {
      settled += dt;
      if (settled > 0.8) end(fate === 'orbit' ? 'captured' : 'lost');
    } else settled = 0;
  }

  function dashed(points: { x: number; y: number }[], color: string, alpha: number) {
    ctx.strokeStyle = color; ctx.lineWidth = 1.25; ctx.setLineDash([4, 6]);
    const chunks = 10, per = Math.ceil(points.length / chunks);
    for (let c = 0; c < chunks; c++) {
      const part = points.slice(c * per, (c + 1) * per + 1);
      if (part.length < 2) break;
      ctx.globalAlpha = alpha * (1 - c / chunks);
      ctx.beginPath();
      part.forEach((p, i) => (i ? ctx.lineTo(sx(p.x), sy(p.y)) : ctx.moveTo(sx(p.x), sy(p.y))));
      ctx.stroke();
    }
    ctx.setLineDash([]); ctx.globalAlpha = 1;
  }

  function draw() {
    ctx.clearRect(0, 0, w, h);
    const cx = sx(0), cy = sy(0), pr = PLANET_R * scale;

    // Planet, halo and the atmosphere line that must not be crossed
    const halo = ctx.createRadialGradient(cx, cy, pr, cx, cy, pr * 2.8);
    halo.addColorStop(0, 'rgba(167,139,250,0.22)'); halo.addColorStop(1, 'rgba(167,139,250,0)');
    ctx.fillStyle = halo; ctx.beginPath(); ctx.arc(cx, cy, pr * 2.8, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = 'rgba(167,139,250,0.25)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(cx, cy, CRASH_R * scale, 0, Math.PI * 2); ctx.stroke();
    const body = ctx.createRadialGradient(cx - pr * 0.36, cy - pr * 0.44, pr * 0.05, cx, cy, pr);
    body.addColorStop(0, '#ede9fe'); body.addColorStop(0.35, '#a78bfa'); body.addColorStop(0.8, '#6d28d9'); body.addColorStop(1, '#3b0764');
    ctx.fillStyle = body; ctx.beginPath(); ctx.arc(cx, cy, pr, 0, Math.PI * 2); ctx.fill();

    // Where it is heading if you let go now
    if (state !== 'waiting' && state !== 'crashed') {
      const { points, fate } = predict(probe);
      dashed(points, FATE_COLOR[fate], state === 'captured' ? 0.45 : 0.75);
    }

    // Trail
    ctx.lineCap = 'round';
    for (let i = 1; i < trail.length; i++) {
      ctx.globalAlpha = (i / trail.length) * 0.5;
      ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(sx(trail[i - 1].x), sy(trail[i - 1].y)); ctx.lineTo(sx(trail[i].x), sy(trail[i].y)); ctx.stroke();
    }
    ctx.globalAlpha = 1;

    if (state !== 'crashed' && state !== 'waiting') {
      const px = sx(probe.x), py = sy(probe.y);
      ctx.globalAlpha = Math.min(age / 0.6, 1);
      // Retro-thrusters fire forward, along the direction of motion
      if (burning && probe.fuel > 0 && state === 'flying') {
        const v = Math.hypot(probe.vx, probe.vy), ux = probe.vx / v, uy = -probe.vy / v;
        const len = 16 + Math.random() * 8;
        const flame = ctx.createLinearGradient(px, py, px + ux * len, py + uy * len);
        flame.addColorStop(0, 'rgba(255,251,235,0.95)'); flame.addColorStop(1, 'rgba(251,191,36,0)');
        ctx.fillStyle = flame;
        ctx.beginPath();
        ctx.moveTo(px + ux * 2 - uy * 3.5, py + uy * 2 + ux * 3.5);
        ctx.lineTo(px + ux * len, py + uy * len);
        ctx.lineTo(px + ux * 2 + uy * 3.5, py + uy * 2 - ux * 3.5);
        ctx.fill();
        ctx.fillStyle = 'rgba(251,191,36,0.25)';
        ctx.beginPath(); ctx.arc(px + ux * 7, py + uy * 7, 7, 0, Math.PI * 2); ctx.fill();
      }
      ctx.fillStyle = 'rgba(251,191,36,0.2)'; ctx.beginPath(); ctx.arc(px, py, 9, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#fde68a'; ctx.beginPath(); ctx.arc(px, py, 3.5, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
    }

    if (boom && boom.t < 1.2) {
      const k = boom.t / 1.2, bx = sx(boom.x), by = sy(boom.y);
      ctx.globalAlpha = 1 - k;
      ctx.fillStyle = '#fef3c7'; ctx.beginPath(); ctx.arc(bx, by, 4 + 10 * (1 - k), 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = '#f87171'; ctx.lineWidth = 1.5; ctx.beginPath(); ctx.arc(bx, by, 6 + 40 * k, 0, Math.PI * 2); ctx.stroke();
      ctx.globalAlpha = 1;
    }
  }

  function hud() {
    fuelBar.style.transform = `scaleX(${probe.fuel / FUEL})`;
    if (state !== 'flying' && state !== 'captured') return;
    const { e } = elements(probe);
    const fate = fateOf(probe);
    ecc.textContent = `e ${e.toFixed(2)} · ${fate === 'escape' && e < 1 ? 'orbit too wide' : FATE_LABEL[fate]}`;
    ecc.style.color = FATE_COLOR[fate];
  }

  function frame(t: number) {
    const dt = Math.min((t - last) / 1000, 0.05);
    last = t;
    update(dt); draw(); hud();
    requestAnimationFrame(frame);
  }

  // Controls: hold anywhere on the map, or hold Space
  function press() {
    if (state === 'waiting') return reset();
    if (state !== 'flying') return;
    burning = true;
    if (!touched) { touched = true; hint.style.opacity = '0'; }
  }
  const release = () => { burning = false; };
  canvas.addEventListener('pointerdown', e => {
    if (state === 'crashed' || state === 'lost' || state === 'captured') return reset();
    canvas.setPointerCapture(e.pointerId); press();
  });
  canvas.addEventListener('pointerup', release);
  canvas.addEventListener('pointercancel', release);
  addEventListener('keydown', e => {
    if (e.code !== 'Space' || (e.target as HTMLElement).closest('a, button, input, textarea')) return;
    e.preventDefault();
    if (e.repeat) return;
    if (state === 'crashed' || state === 'lost' || state === 'captured') return reset();
    press();
  });
  addEventListener('keyup', e => { if (e.code === 'Space') release(); });
  again.addEventListener('click', reset);
  addEventListener('blur', release);

  resize();
  addEventListener('resize', resize);
  // With reduced motion nothing moves until the visitor asks for it
  if (reduced) say('Catch the probe', 'It is on its way out. Brake it into an orbit around the planet.', 'Start');
  else reset();
  requestAnimationFrame(t => { last = t; requestAnimationFrame(frame); });
</script>
