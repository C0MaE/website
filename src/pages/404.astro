---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lost in space — CoMaE" description="This page doesn't exist (anymore)." noindex>
  <main class="relative min-h-screen flex items-center overflow-hidden px-5 py-24">
    <!-- A probe finishes one last lap, then reaches escape velocity and leaves the frame -->
    <div class="absolute inset-x-0 top-4 h-72 opacity-70 lg:opacity-100 lg:top-0 lg:bottom-0 lg:h-auto lg:left-[55%] pointer-events-none" aria-hidden="true">
      <svg viewBox="-190 -130 620 520" class="w-full h-full" preserveAspectRatio="xMidYMid meet">
        <defs>
          <radialGradient id="planet" cx="0.5" cy="0.5" fx="0.32" fy="0.28" r="0.6">
            <stop offset="0" stop-color="#ede9fe" />
            <stop offset="0.35" stop-color="#a78bfa" />
            <stop offset="0.8" stop-color="#6d28d9" />
            <stop offset="1" stop-color="#3b0764" />
          </radialGradient>
          <radialGradient id="halo">
            <stop offset="0" stop-color="#a78bfa" stop-opacity="0.35" />
            <stop offset="1" stop-color="#a78bfa" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="escape" gradientUnits="userSpaceOnUse" x1="0" y1="-75" x2="420" y2="220">
            <stop offset="0" stop-color="#fbbf24" stop-opacity="0.7" />
            <stop offset="1" stop-color="#fbbf24" stop-opacity="0" />
          </linearGradient>
        </defs>
        <ellipse rx="150" ry="75" fill="none" stroke="#a1a1aa" stroke-opacity="0.25" stroke-dasharray="3 6" />
        <path d="M-0.0 -75.0 L3.0 -75.0 L6.0 -75.0 L9.0 -75.1 L12.0 -75.1 L15.1 -75.2 L18.2 -75.3 L21.2 -75.4 L24.4 -75.5 L27.5 -75.6 L30.7 -75.7 L33.9 -75.8 L37.2 -76.0 L40.5 -76.2 L43.9 -76.3 L47.3 -76.5 L50.8 -76.7 L54.4 -76.8 L58.0 -77.0 L61.7 -77.2 L65.4 -77.4 L69.3 -77.5 L73.2 -77.7 L77.2 -77.9 L81.2 -78.0 L85.4 -78.2 L89.6 -78.3 L94.0 -78.4 L98.4 -78.5 L102.9 -78.6 L107.6 -78.6 L112.3 -78.6 L117.1 -78.6 L122.0 -78.6 L127.0 -78.5 L132.1 -78.4 L137.4 -78.3 L142.7 -78.1 L148.1 -77.9 L153.6 -77.6 L159.3 -77.3 L165.0 -77.0 L170.8 -76.6 L176.7 -76.1 L182.8 -75.5 L188.9 -74.9 L195.1 -74.3 L201.4 -73.5 L207.8 -72.7 L214.3 -71.9 L220.9 -70.9 L227.6 -69.9 L234.3 -68.8 L241.1 -67.6 L248.0 -66.3 L255.0 -64.9 L262.0 -63.4 L269.1 -61.8 L276.3 -60.2 L283.5 -58.4 L290.8 -56.5 L298.1 -54.5 L305.5 -52.5 L312.9 -50.2 L320.3 -47.9 L327.7 -45.5 L335.2 -42.9 L342.7 -40.3 L350.2 -37.5 L357.6 -34.5 L365.1 -31.5 L372.6 -28.3 L380.0 -25.0 L387.4 -21.6 L394.8 -18.0 L402.1 -14.3 L409.4 -10.4 L416.6 -6.4 L423.8 -2.3 L430.8 2.0 L437.8 6.4 L444.7 10.9 L451.5 15.6 L458.2 20.5 L464.7 25.5" fill="none" stroke="url(#escape)" stroke-width="1.5" stroke-dasharray="4 6" />
        <circle r="80" fill="url(#halo)" />
        <circle r="30" fill="url(#planet)" />
        <path id="probe-path" d="M0.0 -75.0 L9.8 -74.8 L19.6 -74.4 L29.3 -73.6 L38.8 -72.4 L48.2 -71.0 L57.4 -69.3 L66.3 -67.3 L75.0 -65.0 L83.3 -62.4 L91.3 -59.5 L98.9 -56.4 L106.1 -53.0 L112.8 -49.5 L119.0 -45.7 L124.7 -41.7 L129.9 -37.5 L134.5 -33.2 L138.6 -28.7 L142.0 -24.1 L144.9 -19.4 L147.1 -14.6 L148.7 -9.8 L149.7 -4.9 L150.0 0.0 L149.7 4.9 L148.7 9.8 L147.1 14.6 L144.9 19.4 L142.0 24.1 L138.6 28.7 L134.5 33.2 L129.9 37.5 L124.7 41.7 L119.0 45.7 L112.8 49.5 L106.1 53.0 L98.9 56.4 L91.3 59.5 L83.3 62.4 L75.0 65.0 L66.3 67.3 L57.4 69.3 L48.2 71.0 L38.8 72.4 L29.3 73.6 L19.6 74.4 L9.8 74.8 L0.0 75.0 L-9.8 74.8 L-19.6 74.4 L-29.3 73.6 L-38.8 72.4 L-48.2 71.0 L-57.4 69.3 L-66.3 67.3 L-75.0 65.0 L-83.3 62.4 L-91.3 59.5 L-98.9 56.4 L-106.1 53.0 L-112.8 49.5 L-119.0 45.7 L-124.7 41.7 L-129.9 37.5 L-134.5 33.2 L-138.6 28.7 L-142.0 24.1 L-144.9 19.4 L-147.1 14.6 L-148.7 9.8 L-149.7 4.9 L-150.0 0.0 L-149.7 -4.9 L-148.7 -9.8 L-147.1 -14.6 L-144.9 -19.4 L-142.0 -24.1 L-138.6 -28.7 L-134.5 -33.2 L-129.9 -37.5 L-124.7 -41.7 L-119.0 -45.7 L-112.8 -49.5 L-106.1 -53.0 L-98.9 -56.4 L-91.3 -59.5 L-83.3 -62.4 L-75.0 -65.0 L-66.3 -67.3 L-57.4 -69.3 L-48.2 -71.0 L-38.8 -72.4 L-29.3 -73.6 L-19.6 -74.4 L-9.8 -74.8 L-0.0 -75.0 L3.0 -75.0 L6.0 -75.0 L9.0 -75.1 L12.0 -75.1 L15.1 -75.2 L18.2 -75.3 L21.2 -75.4 L24.4 -75.5 L27.5 -75.6 L30.7 -75.7 L33.9 -75.8 L37.2 -76.0 L40.5 -76.2 L43.9 -76.3 L47.3 -76.5 L50.8 -76.7 L54.4 -76.8 L58.0 -77.0 L61.7 -77.2 L65.4 -77.4 L69.3 -77.5 L73.2 -77.7 L77.2 -77.9 L81.2 -78.0 L85.4 -78.2 L89.6 -78.3 L94.0 -78.4 L98.4 -78.5 L102.9 -78.6 L107.6 -78.6 L112.3 -78.6 L117.1 -78.6 L122.0 -78.6 L127.0 -78.5 L132.1 -78.4 L137.4 -78.3 L142.7 -78.1 L148.1 -77.9 L153.6 -77.6 L159.3 -77.3 L165.0 -77.0 L170.8 -76.6 L176.7 -76.1 L182.8 -75.5 L188.9 -74.9 L195.1 -74.3 L201.4 -73.5 L207.8 -72.7 L214.3 -71.9 L220.9 -70.9 L227.6 -69.9 L234.3 -68.8 L241.1 -67.6 L248.0 -66.3 L255.0 -64.9 L262.0 -63.4 L269.1 -61.8 L276.3 -60.2 L283.5 -58.4 L290.8 -56.5 L298.1 -54.5 L305.5 -52.5 L312.9 -50.2 L320.3 -47.9 L327.7 -45.5 L335.2 -42.9 L342.7 -40.3 L350.2 -37.5 L357.6 -34.5 L365.1 -31.5 L372.6 -28.3 L380.0 -25.0 L387.4 -21.6 L394.8 -18.0 L402.1 -14.3 L409.4 -10.4 L416.6 -6.4 L423.8 -2.3 L430.8 2.0 L437.8 6.4 L444.7 10.9 L451.5 15.6 L458.2 20.5 L464.7 25.5" fill="none" />
        <g id="probe">
          <circle r="9" fill="#fbbf24" opacity="0.18" />
          <circle r="3.5" fill="#fde68a" />
          <!-- Lap at constant speed, a gentle burn out of orbit that fades as it climbs away, then a pause -->
          <animateMotion dur="10.6s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.566;0.849;1" keyPoints="0;0.599;1;1" keySplines="0 0 1 1;0.35 0.25 0.65 1;0 0 1 1">
            <mpath href="#probe-path" />
          </animateMotion>
          <animate attributeName="opacity" dur="10.6s" repeatCount="indefinite" keyTimes="0;0.03;0.83;0.849;1" values="0;1;1;0;0" />
        </g>
      </svg>
    </div>

    <div class="relative z-10 page-container">
      <p class="font-mono text-xs text-muted tracking-wider mb-6">404 · Page not found</p>
      <h1 class="font-serif text-7xl sm:text-8xl md:text-9xl leading-[0.9] text-zinc-50 mb-6">
        Escaped <em class="text-accent-light">orbit.</em>
      </h1>
      <p class="text-zinc-300 text-lg md:text-xl leading-relaxed max-w-lg mb-10">
        This page reached escape velocity — or never existed. Everything else is still where it should be.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/" class="px-5 py-2.5 bg-zinc-100 hover:bg-white text-zinc-950 rounded-full font-medium text-sm transition-colors">
          ← Back home
        </a>
        <a href="/#projects" class="px-5 py-2.5 border border-zinc-700 hover:border-zinc-400 text-zinc-300 hover:text-white rounded-full text-sm transition-colors">
          See my projects
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  // SMIL ignores prefers-reduced-motion, so park the probe on its way out instead
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const probe = document.getElementById('probe')!;
    const path = document.getElementById('probe-path') as unknown as SVGPathElement;
    probe.querySelectorAll('animate, animateMotion').forEach(a => a.remove());
    const p = path.getPointAtLength(path.getTotalLength() * 0.72);
    probe.setAttribute('transform', `translate(${p.x} ${p.y})`);
  }
</script>
