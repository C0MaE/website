---
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="mb-10 md:mb-14">
  <h2 class="text-[1.75rem] md:text-3xl font-semibold leading-tight text-zinc-50 pb-4 border-b border-zinc-800">{title}</h2>
  {intro && <p class="mt-4 text-zinc-400 max-w-2xl">{intro}</p>}
</header>
