---
interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string | null;
  live?: string | null;
  image?: string | null;
  video?: string | null;
  label?: string | null;
  labelUrl?: string | null;
  tone?: 'violet' | 'emerald';
  /** How the preview fills its frame: screenshots crop, diagrams and renders fit */
  fit?: 'cover' | 'contain';
}

const {
  title, description, tags, github, live, image, video,
  label, labelUrl, tone = 'violet', fit = 'cover',
} = Astro.props;

const labelColor = tone === 'emerald' ? 'text-emerald-400' : 'text-accent-light';
const primaryHref = live ?? github ?? null;
---

<article class="reveal group flex flex-col bg-zinc-900/60 border border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-600 transition-colors">
  <!-- Preview -->
  <a
    href={primaryHref ?? undefined}
    target={primaryHref ? '_blank' : undefined}
    rel={primaryHref ? 'noopener noreferrer' : undefined}
    class="block relative aspect-[16/10] bg-black border-b border-zinc-800 overflow-hidden"
    tabindex="-1"
    aria-hidden="true"
  >
    {video ? (
      <video
        aria-label={`${title} — preview animation`}
        src={video}
        poster={image ?? undefined}
        autoplay muted loop playsinline preload="metadata"
        class="autoplay-video w-full h-full object-contain"
      />
    ) : image ? (
      <img
        src={image}
        alt={`${title} — preview`}
        loading="lazy"
        class={`w-full h-full ${fit === 'contain' ? 'object-contain' : 'object-cover object-top'} group-hover:scale-[1.02] transition-transform duration-500`}
      />
    ) : (
      <div class="w-full h-full grid place-items-center font-serif text-4xl text-zinc-700">{title}</div>
    )}
  </a>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-5 md:p-6">
    {label && (
      <p class={`font-mono text-[11px] uppercase tracking-wider mb-2 ${labelColor}`}>
        {labelUrl ? (
          <a href={labelUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">{label}</a>
        ) : label}
      </p>
    )}
    <div class="flex items-start justify-between gap-4 mb-2">
      <h3 class="text-xl font-semibold text-zinc-50">{title}</h3>
      <div class="flex shrink-0 gap-2">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`${title} on GitHub`} class="w-9 h-9 grid place-items-center rounded-full border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-500 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
        )}
        {live && (
          <a href={live} target="_blank" rel="noopener noreferrer" class="h-9 px-3.5 inline-flex items-center gap-1.5 rounded-full bg-zinc-100 text-zinc-950 text-xs font-medium hover:bg-white transition-colors">
            Live <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
    <p class="text-zinc-400 text-sm leading-relaxed mb-5">{description}</p>

    <ul class="mt-auto flex flex-wrap gap-1.5">
      {tags.map(tag => (
        <li class="font-mono text-[11px] px-2 py-0.5 rounded-full border border-zinc-800 text-zinc-400">{tag}</li>
      ))}
    </ul>
  </div>
</article>
