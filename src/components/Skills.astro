---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface SkillCategory {
  name: string;
  icon: string;
  skills: string[];
}

const categories = await fetchData<SkillCategory[]>('skills.json');
---

<section id="skills" class="py-20 md:py-28 px-5">
  <div class="max-w-5xl mx-auto">
    <SectionHeader eyebrow="Skills" title="The <em class='text-accent-light'>toolbox</em>" />

    <dl class="border-t border-zinc-800">
      {categories.map(cat => (
        <div class="reveal grid md:grid-cols-[14rem_1fr] gap-3 md:gap-8 py-5 border-b border-zinc-800">
          <dt class="text-zinc-100 font-medium">{cat.name}</dt>
          <dd class="flex flex-wrap gap-2">
            {cat.skills.map(skill => (
              <span class="font-mono text-xs px-2.5 py-1 rounded-full border border-zinc-800 text-zinc-400">{skill}</span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
