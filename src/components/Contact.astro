---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface ContactData {
  email: string;
  socials: { label: string; href: string }[];
}

const { email, socials } = await fetchData<ContactData>('contact.json');
const { name } = await fetchData<{ name?: string }>('hero.json');

// Keep the address out of the HTML so simple scrapers can't harvest it; the browser decodes it on load
const encodedEmail = Buffer.from(email.split('').reverse().join('')).toString('base64');
---

<section id="contact" class="pt-14 md:pt-20 pb-10 px-5">
  <div class="page-container">
    <SectionHeader title="Contact" />
    <p class="text-lg md:text-xl leading-relaxed text-zinc-300 max-w-xl mb-6">
      Questions, ideas or just hello: email is the best way to reach me.
    </p>

    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-lg">
      <li><a href="#contact" data-mail={encodedEmail} class="mail-link link">Email</a></li>
      {socials.map(s => (
        <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="link">{s.label}</a></li>
      ))}
    </ul>
  </div>

  <footer class="page-container mt-24 pt-6 border-t border-zinc-900 flex flex-col sm:flex-row justify-between gap-1 text-[15px] text-faint">
    <span>© {new Date().getFullYear()} {name ? `${name} (CoMaE)` : 'CoMaE'}</span>
    <span>Kiel, 54.32° N</span>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.mail-link').forEach((a) => {
    const address = atob(a.dataset.mail ?? '').split('').reverse().join('');
    if (address) a.href = `mailto:${address}`;
  });
</script>
