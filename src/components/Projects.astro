---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface Project {
  title: string;
  description: string;
  tags: string[];
  github: string | null;
  live: string | null;
  featured: boolean;
  image: string | null;
}

// Only the featured ones; the rest stay in the data for llms.txt
const projects = (await fetchData<Project[]>('projects.json')).filter(p => p.featured);
const host = (url: string) => new URL(url).host;
---

<section id="projects" class="py-14 md:py-20 px-5">
  <div class="page-container">
    <SectionHeader title="Projects" intro="Software I've built outside of university." />

    <ul class="grid lg:grid-cols-2 gap-x-16 gap-y-12">
      {projects.map(p => {
        const href = p.live ?? p.github;
        return (
          <li class="grid grid-cols-[5.5rem_1fr] sm:grid-cols-[11rem_1fr] gap-4 sm:gap-6 items-start">
            <a
              href={href ?? undefined}
              target="_blank"
              rel="noopener noreferrer"
              class="block aspect-[16/10] bg-black border border-zinc-900 overflow-hidden mt-1"
              tabindex="-1"
              aria-hidden="true"
            >
              {p.image && (
                <img
                  src={p.image}
                  alt=""
                  width="1280"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class={`w-full h-full ${p.image.endsWith('.svg') ? 'object-contain' : 'object-cover object-top'}`}
                />
              )}
            </a>
            <div>
              <h3 class="text-lg font-semibold leading-snug text-zinc-50 mb-1">{p.title}</h3>
              <p class="text-[15px] leading-relaxed text-zinc-400 mb-2">{p.description}</p>
              <p class="text-[15px] text-muted mb-2">{p.tags.join(', ')}</p>
              <p class="text-[15px] flex flex-wrap gap-x-5">
                {p.live && <a href={p.live} target="_blank" rel="noopener noreferrer" class="link">{host(p.live)} ↗</a>}
                {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer" class="link">Code ↗</a>}
              </p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
