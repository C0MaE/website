---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';
import WorkCard from './WorkCard.astro';

interface Project {
  title: string;
  description: string;
  tags: string[];
  github: string | null;
  live: string | null;
  featured: boolean;
  image: string | null;
}

const projects = await fetchData<Project[]>('projects.json');
const featured = projects.filter(p => p.featured);
const others = projects.filter(p => !p.featured);
---

<section id="projects" class="py-20 md:py-28 px-5 bg-zinc-900/30">
  <div class="max-w-5xl mx-auto">
    <SectionHeader eyebrow="Projects" title="Things I've <em class='text-accent-light'>built</em>" />

    <div class="grid md:grid-cols-2 gap-5">
      {featured.map(p => (
        <WorkCard
          title={p.title}
          description={p.description}
          tags={p.tags}
          github={p.github}
          live={p.live}
          image={p.image}
          fit={p.image?.endsWith('.svg') ? 'contain' : 'cover'}
        />
      ))}
    </div>

    {others.length > 0 && (
      <div class="reveal mt-14">
        <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500 mb-4">Smaller things</p>
        <ul class="divide-y divide-zinc-800 border-y border-zinc-800">
          {others.map(p => (
            <li>
              <a
                href={p.live ?? p.github ?? undefined}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 hover:bg-zinc-900/60 -mx-3 px-3 rounded-lg transition-colors"
              >
                <span class="font-medium text-zinc-100 sm:w-48 shrink-0 group-hover:text-white">{p.title}</span>
                <span class="text-sm text-zinc-500 flex-1">{p.description}</span>
                <span class="font-mono text-xs text-zinc-600">{p.tags.join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
