---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';
import WorkCard from './WorkCard.astro';

interface ResearchProject {
  title: string;
  description: string;
  affiliation: string | null;
  affiliationUrl: string | null;
  tags: string[];
  github: string | null;
  image: string | null;
  video: string | null;
}

const projects = await fetchData<ResearchProject[]>('research.json');
---

<section id="research" class="py-20 md:py-28 px-5">
  <div class="max-w-5xl mx-auto">
    <SectionHeader
      eyebrow="Research & Uni"
      title="Science, <em class='text-emerald-300'>in code</em>"
      intro="Software I build alongside my physics studies — tools for simulations, data and the lab."
    />

    <div class="grid md:grid-cols-2 gap-5">
      {projects.map(p => (
        <WorkCard
          title={p.title}
          description={p.description}
          tags={p.tags}
          github={p.github}
          image={p.image}
          video={p.video}
          label={p.affiliation}
          labelUrl={p.affiliationUrl}
          tone="emerald"
          fit={p.image?.endsWith('.svg') ? 'contain' : 'cover'}
        />
      ))}
    </div>
  </div>
</section>
