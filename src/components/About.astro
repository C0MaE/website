---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface AboutData {
  paragraphs: string[];
}

const { paragraphs } = await fetchData<AboutData>('about.json');
---

<section id="about" class="py-20 md:py-28 px-5 border-t border-zinc-900">
  <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_2fr] gap-8 md:gap-16">
    <div class="reveal">
      <SectionHeader eyebrow="About" title="Hi, <em class='text-accent-light'>I'm CoMaE</em>" />
      <img src="/profile_pic_light.svg" alt="" width="72" height="72" class="w-16 h-16 md:w-20 md:h-20 -mt-4" />
    </div>
    <div class="reveal space-y-5 text-zinc-300 text-base md:text-lg leading-relaxed md:pt-8">
      {paragraphs.map(p => <p set:html={p} />)}
    </div>
  </div>
</section>
