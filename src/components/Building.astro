---
import { fetchData } from '../lib/fetchData';
import { fetchLog, formatDate } from '../lib/logbook';
import SectionHeader from './SectionHeader.astro';
import 'katex/dist/katex.min.css';

// What is being worked on right now, with its milestones. Lives in data/building.json,
// so ticking off a milestone goes live without a rebuild.
interface Milestone { label: string; status: 'done' | 'active' | 'todo' }
interface Building {
  title: string;
  question: string;
  description: string;
  started: string;
  target?: string;
  repo?: string | null;
  /** Raw URL of the project's LOG.md (see lib/logbook.ts) */
  log?: string | null;
  tags: string[];
  milestones: Milestone[];
}

const items = await fetchData<Building[]>('building.json');
const logs = await Promise.all(items.map(item => (item.log ? fetchLog(item.log) : Promise.resolve([]))));
---

{items.length > 0 && (
  <section id="building" class="py-14 md:py-20 px-5">
    <div class="page-container">
      <SectionHeader title="In progress" />

      <div class="space-y-16">
        {items.map((item, index) => {
          const done = item.milestones.filter(m => m.status === 'done').length;
          const latest = logs[index][0];
          return (
            <article class="grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-10 lg:gap-16">
              <div>
                <h3 class="text-xl md:text-2xl font-semibold leading-snug text-zinc-50 mb-1">{item.title}</h3>
                <p class="text-[15px] text-muted mb-5">
                  Since {item.started}
                  {item.repo && (
                    <>
                      <span aria-hidden="true"> · </span>
                      <a href={item.repo} target="_blank" rel="noopener noreferrer" class="link">Code on GitHub ↗</a>
                    </>
                  )}
                </p>
                <p class="text-xl md:text-[1.375rem] italic leading-snug text-zinc-100 mb-5">{item.question}</p>
                <p class="leading-relaxed text-zinc-300 mb-4">{item.description}</p>
                <p class="text-[15px] text-muted">{item.tags.join(', ')}</p>
              </div>

              <div>
                <h4 class="text-[15px] text-muted mb-4">Milestones, {done} of {item.milestones.length} done</h4>
                <ol class="space-y-2.5">
                  {item.milestones.map(m => (
                    <li class="grid grid-cols-[1.25rem_1fr] gap-2 leading-snug">
                      <span class={m.status === 'active' ? 'text-accent' : 'text-zinc-500'} aria-hidden="true">
                        {m.status === 'done' ? '✓' : m.status === 'active' ? '→' : '·'}
                      </span>
                      <span class={m.status === 'todo' ? 'text-muted' : m.status === 'active' ? 'text-zinc-50' : 'text-zinc-400'}>
                        {m.label}
                        <span class="sr-only">{m.status === 'done' ? ' (done)' : m.status === 'active' ? ' (in progress)' : ' (to do)'}</span>
                      </span>
                    </li>
                  ))}
                </ol>
                {item.target && <p class="mt-5 text-[15px] italic text-muted">{item.target}</p>}
              </div>

              {latest && (
                <div class="lg:col-span-2 border-t border-zinc-800 pt-8">
                  <div class="flex items-baseline justify-between gap-4 mb-6">
                    <h4 class="text-[15px] text-muted">Latest from the logbook</h4>
                    <a href="/log" class="text-[15px] link">All entries →</a>
                  </div>
                  <div class="grid md:grid-cols-[8rem_1fr] gap-1 md:gap-8">
                    <time datetime={latest.date} class="text-[15px] text-muted md:pt-0.5">{formatDate(latest.date)}</time>
                    <div class="max-w-[42rem]">
                      <h5 class="text-lg font-semibold text-zinc-100 mb-2">{latest.title}</h5>
                      <div class="log-body leading-relaxed text-zinc-400" set:html={latest.html} />
                    </div>
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
