---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface TimelineEvent {
  year: string;
  title: string;
  place: string;
  description: string;
  type: 'education' | 'work' | 'milestone' | 'graduation';
  /** Still going on: rides along with "now" instead of sitting on the path as a passed station */
  ongoing?: boolean;
}

const events = await fetchData<TimelineEvent[]>('timeline.json');

const planet: Record<string, string> = {
  education: 'bg-accent-light shadow-accent-light/50',
  work: 'bg-emerald-400 shadow-emerald-400/50',
  milestone: 'bg-zinc-400 shadow-zinc-400/40',
  graduation: 'bg-amber-400 shadow-amber-400/50',
};
const moon: Record<string, string> = {
  education: 'bg-accent-light',
  work: 'bg-emerald-400',
  milestone: 'bg-zinc-400',
  graduation: 'bg-amber-400',
};

const hasDate = (e: TimelineEvent) => /\d{4}/.test(e.year);
const isCurrent = (e: TimelineEvent) => e.ongoing || !hasDate(e);

// "Now" first (undated), then the most recently started
const current = events.filter(isCurrent).reverse().sort((a, b) => Number(hasDate(a)) - Number(hasDate(b)));
const past = events.filter(e => !isCurrent(e)).reverse();

// Each row is pushed sideways along an arc (right → left → right), so the curve drawn
// through the dots reads as a trajectory rising towards "now"
const rows = (current.length ? 1 : 0) + past.length;
const offsetAt = (i: number) => {
  const t = rows > 1 ? i / (rows - 1) : 0;
  return ((1 - Math.sin(Math.PI * t)) * (1 - 0.45 * t)).toFixed(3);
};
const pastOffset = current.length ? 1 : 0;
---

<section id="timeline" class="py-20 md:py-28 px-5">
  <div class="page-container">
    <SectionHeader eyebrow="Journey" title="How I <em class='text-accent-light'>got here</em>" />

    <ol id="trajectory" class="relative [--amp:1.75rem] md:[--amp:min(34vw,32rem)]">
      <svg class="absolute inset-0 w-full h-full overflow-visible pointer-events-none" aria-hidden="true">
        <defs>
          <linearGradient id="traj-gradient" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#3f3f46" stop-opacity="0.4" />
            <stop offset="1" stop-color="#a78bfa" stop-opacity="0.9" />
          </linearGradient>
        </defs>
        <path id="traj-path" d="" fill="none" stroke="url(#traj-gradient)" stroke-width="1.5" stroke-dasharray="4 6" />
        <circle r="3" fill="#fde68a" class="motion-reduce:hidden drop-shadow-[0_0_6px_#fbbf24]">
          <animateMotion dur="9s" repeatCount="indefinite" rotate="auto">
            <mpath href="#traj-path" />
          </animateMotion>
        </circle>
      </svg>

      {current.length > 0 && (
        <li class="reveal relative pb-12" style={`padding-left: calc(${offsetAt(0)} * var(--amp) + 2.75rem)`}>
          <!-- "Now" planet; everything still ongoing orbits it as a moon and travels with it -->
          <span class="traj-dot absolute top-0 w-5 h-5 -ml-1 rounded-full bg-accent-light shadow-[0_0_18px] shadow-accent-light/60" style={`left: calc(${offsetAt(0)} * var(--amp))`}>
            {current.map((e, k) => (
              <span
                class={`moon absolute left-1/2 top-1/2 -ml-[3px] -mt-[3px] w-1.5 h-1.5 rounded-full ${moon[e.type] ?? 'bg-zinc-400'}`}
                style={`--r: ${16 + k * 7}px; --start: ${k * 137}deg; animation-duration: ${5 + k * 2.5}s`}
              />
            ))}
          </span>

          <p class="font-mono text-[11px] uppercase tracking-widest text-accent-light mb-3">Now</p>
          <div class="grid gap-6">
            {current.map(e => (
              <article>
                <h3 class="flex items-center gap-2.5 text-zinc-50 font-medium text-lg leading-snug">
                  <span class={`w-1.5 h-1.5 shrink-0 rounded-full ${moon[e.type] ?? 'bg-zinc-400'}`} />
                  {e.title}
                </h3>
                <p class="font-mono text-xs text-zinc-500 mb-2 pl-4">
                  {e.place}{hasDate(e) && <span class="text-zinc-600"> · since {e.year}</span>}
                </p>
                <p class="text-sm text-zinc-400 leading-relaxed max-w-md pl-4">{e.description}</p>
              </article>
            ))}
          </div>
        </li>
      )}

      {past.map((e, i) => {
        const x = offsetAt(i + pastOffset);
        return (
          <li class="reveal relative pb-10 last:pb-0" style={`padding-left: calc(${x} * var(--amp) + 2.25rem)`}>
            <span
              class={`traj-dot absolute top-1 w-3 h-3 rounded-full shadow-[0_0_14px] ${planet[e.type] ?? 'bg-zinc-500'}`}
              style={`left: calc(${x} * var(--amp))`}
            />
            <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500 mb-1">{e.year}</p>
            <h3 class="text-zinc-50 font-medium text-lg leading-snug">{e.title}</h3>
            <p class="font-mono text-xs text-zinc-500 mb-2">{e.place}</p>
            <p class="text-sm text-zinc-400 leading-relaxed max-w-md">{e.description}</p>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .moon {
    transform: rotate(var(--start)) translateX(var(--r));
    animation: moon-orbit linear infinite;
  }
  @keyframes moon-orbit {
    from { transform: rotate(var(--start)) translateX(var(--r)); }
    to { transform: rotate(calc(var(--start) + 360deg)) translateX(var(--r)); }
  }
</style>

<script>
  const list = document.getElementById('trajectory')!;
  const path = document.getElementById('traj-path')!;

  // Smooth curve through the dot centres (Catmull-Rom → cubic Bézier), oldest first so the comet climbs.
  // offsetLeft/offsetTop ignore transforms, so the reveal animation doesn't skew the measurement.
  function draw() {
    const pts = [...list.querySelectorAll<HTMLElement>('.traj-dot')].map((dot) => {
      const li = dot.parentElement!;
      return {
        x: li.offsetLeft + dot.offsetLeft + dot.offsetWidth / 2,
        y: li.offsetTop + dot.offsetTop + dot.offsetHeight / 2,
      };
    }).reverse();
    if (pts.length < 2) return;

    let d = `M ${pts[0].x} ${pts[0].y}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] ?? pts[i];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2] ?? p2;
      const c1 = { x: p1.x + (p2.x - p0.x) / 6, y: p1.y + (p2.y - p0.y) / 6 };
      const c2 = { x: p2.x - (p3.x - p1.x) / 6, y: p2.y - (p3.y - p1.y) / 6 };
      d += ` C ${c1.x} ${c1.y}, ${c2.x} ${c2.y}, ${p2.x} ${p2.y}`;
    }
    path.setAttribute('d', d);
  }

  new ResizeObserver(draw).observe(list);
  document.fonts?.ready.then(draw);
  draw();
</script>
