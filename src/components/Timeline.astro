---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface TimelineEvent {
  year: string;
  title: string;
  place: string;
  description: string;
  type: 'education' | 'work' | 'milestone' | 'graduation';
  /** Still going on: the bar runs up to today */
  ongoing?: boolean;
  /** For something that has ended ("Mar 2027") */
  until?: string;
}

const events = await fetchData<TimelineEvent[]>('timeline.json');

// One colour per kind of station, as glowing bars and dots
const tone: Record<string, string> = {
  education: '#a78bfa',
  work: '#34d399',
  milestone: '#a1a1aa',
  graduation: '#fbbf24',
};
const legend: Record<string, string> = { education: 'Study', work: 'Work', graduation: 'Graduation', milestone: 'Milestone' };
const colorOf = (e: TimelineEvent) => tone[e.type] ?? tone.milestone;

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
// "Jul 2024" → 2024.5, the start of that month
const at = (label: string) => {
  const year = Number(label.match(/\d{4}/)![0]);
  const month = MONTHS.indexOf(label.trim().slice(0, 3).toLowerCase());
  return year + (month >= 0 ? month / 12 : 0);
};
const today = new Date();
const now = today.getFullYear() + (today.getMonth() + (today.getDate() - 1) / 31) / 12;

// Linear time axis from just before the first event's year to a little past today
const dated = events.filter(e => /\d{4}/.test(e.year));
const firstYear = Math.floor(Math.min(...dated.map(e => at(e.year))));
const first = firstYear - 0.2, last = now + 0.35;
const x = (t: number) => (((t - first) / (last - first)) * 100).toFixed(2);
const years = Array.from({ length: Math.floor(last) - firstYear + 1 }, (_, i) => firstYear + i);

// Everything with a duration is a bar (newest on top), single events are dots on the bottom row
const bars = dated
  .filter(e => e.until || e.ongoing)
  .map(e => ({ e, from: at(e.year), to: e.until ? Math.min(at(e.until) + 1 / 12, now) : now }))
  .sort((a, b) => b.from - a.from);
const dots = dated.filter(e => !e.until && !e.ongoing).sort((a, b) => at(a.year) - at(b.year));
const kinds = Object.keys(legend).filter(k => dated.some(e => e.type === k));

// The list below the plot: newest first
const when = (e: TimelineEvent) => (e.until ? `${e.year} – ${e.until}` : e.ongoing ? `since ${e.year}` : e.year);
const list = [...events].sort((a, b) => (/\d{4}/.test(b.year) ? at(b.year) : Infinity) - (/\d{4}/.test(a.year) ? at(a.year) : Infinity));
---

<section id="timeline" class="py-14 md:py-20 px-5">
  <div class="page-container">
    <SectionHeader title="Journey" />

    <!-- The plot repeats what the list below says, so screen readers get the list only -->
    <div class="overflow-x-auto -mx-5 px-5 lg:mx-0 lg:px-0" aria-hidden="true" data-plot-scroll>
      <div class="min-w-[680px]">
        <ul class="flex justify-end gap-5 text-sm text-muted mb-6">
          {kinds.map(k => (
            <li class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full" style={`background:${tone[k]}`} />
              {legend[k]}
            </li>
          ))}
        </ul>

        <div class="relative pt-8">
          {years.map(y => (
            <span class="absolute top-8 bottom-0 w-px bg-zinc-800/70" style={`left:${x(y)}%`} />
          ))}
          <span class="absolute top-8 bottom-0 border-l border-dashed border-zinc-500" style={`left:${x(now)}%`} />
          <span class="absolute top-0 -translate-x-1/2 text-sm italic text-zinc-400" style={`left:${x(now)}%`}>today</span>

          <ol class="relative pt-3">
            {bars.map(({ e, from, to }) => (
              <li class="relative h-10">
                <span class="absolute top-1/2 -translate-y-1/2 pr-3 whitespace-nowrap text-[15px] text-zinc-200" style={`right:${(100 - Number(x(from))).toFixed(2)}%`}>
                  {e.title}
                </span>
                <span
                  class="absolute top-1/2 -translate-y-1/2 h-1.5 rounded-full"
                  style={`left:${x(from)}%; width:${(Number(x(to)) - Number(x(from))).toFixed(2)}%; background:${colorOf(e)}; box-shadow:0 0 10px ${colorOf(e)}80`}
                />
                {e.ongoing && (
                  <span
                    class="absolute top-1/2 -translate-y-1/2 h-1.5 rounded-r-full"
                    style={`left:${x(now)}%; width:${(Number(x(last)) - Number(x(now))).toFixed(2)}%; background:linear-gradient(to right, ${colorOf(e)}, transparent)`}
                  />
                )}
              </li>
            ))}
            <li class="relative h-20">
              {dots.map((e, i) => {
                // Alternate rows so neighbouring labels don't collide; labels near today go left of their dot
                const left = Number(x(at(e.year))) > 60;
                return (
                  <span
                    class={`absolute flex items-center gap-2.5 whitespace-nowrap ${left ? 'flex-row-reverse' : ''}`}
                    style={`${left ? `right:${(100 - Number(x(at(e.year)))).toFixed(2)}%` : `left:${x(at(e.year))}%`}; top:${i % 2 ? 2.6 : 0.9}rem`}
                  >
                    <span class={`w-3 h-3 shrink-0 rounded-full ${left ? '-mr-1.5' : '-ml-1.5'}`} style={`background:${colorOf(e)}; box-shadow:0 0 12px ${colorOf(e)}80`} />
                    <span class="text-[15px] text-zinc-300">{e.title}</span>
                  </span>
                );
              })}
            </li>
          </ol>
        </div>

        <div class="relative h-9 border-t border-zinc-600">
          {years.map(y => (
            <span class="absolute top-0 flex flex-col items-center -translate-x-1/2" style={`left:${x(y)}%`}>
              <span class="w-px h-1.5 bg-zinc-600" />
              <span class="mt-1 text-sm text-muted tabular-nums">{y}</span>
            </span>
          ))}
        </div>
      </div>
    </div>

    <ol class="mt-14 grid lg:grid-cols-2 gap-x-16 gap-y-8">
      {list.map(e => (
        <li class="grid grid-cols-[0.75rem_1fr] gap-x-3">
          <span class="w-2 h-2 mt-[0.6rem] rounded-full" style={`background:${colorOf(e)}`} />
          <div>
            <h3 class="font-semibold leading-snug text-zinc-50">{e.title}</h3>
            <p class="text-[15px] text-muted mb-1">{e.place} · {when(e)}</p>
            <p class="text-[15px] leading-relaxed text-zinc-400 max-w-md">{e.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // On narrow screens the plot scrolls sideways; start at the recent end, where most is happening
  document.querySelectorAll<HTMLElement>('[data-plot-scroll]').forEach(el => { el.scrollLeft = el.scrollWidth; });
</script>
