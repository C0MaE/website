---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface TimelineEvent {
  year: string;
  title: string;
  place: string;
  description: string;
  type: 'education' | 'work' | 'milestone' | 'graduation';
}

const events = await fetchData<TimelineEvent[]>('timeline.json');

const dot: Record<string, string> = {
  education: 'bg-accent-light',
  work: 'bg-emerald-400',
  milestone: 'bg-zinc-500',
  graduation: 'bg-amber-400',
};

// Newest first reads better on a phone
const ordered = [...events].reverse();
---

<section id="timeline" class="py-20 md:py-28 px-5 bg-zinc-900/30">
  <div class="page-container">
    <SectionHeader eyebrow="Journey" title="How I <em class='text-accent-light'>got here</em>" />

    <ol class="relative border-l border-zinc-800 md:border-l-0 ml-1.5 md:ml-0">
      {ordered.map(e => (
        <li class="reveal relative pl-6 md:pl-0 pb-9 last:pb-0 md:grid md:grid-cols-[9rem_1fr] md:gap-8">
          <span class={`absolute -left-[5px] md:left-[8.6rem] top-1.5 w-2.5 h-2.5 rounded-full ring-4 ring-zinc-950 ${dot[e.type]}`} />
          <p class="font-mono text-xs text-zinc-500 mb-1 md:mb-0 md:pt-1 md:text-right md:pr-6">{e.year}</p>
          <div class="md:pl-6 md:border-l md:border-zinc-800">
            <h3 class="text-zinc-100 font-medium">{e.title}</h3>
            <p class="font-mono text-xs text-zinc-500 mb-2">{e.place}</p>
            <p class="text-sm text-zinc-400 leading-relaxed max-w-xl">{e.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
