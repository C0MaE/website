---
import { fetchData } from '../lib/fetchData';
import SectionHeader from './SectionHeader.astro';

interface TimelineEvent {
  year: string;
  title: string;
  place: string;
  description: string;
  type: 'education' | 'work' | 'milestone' | 'graduation';
  /** Still going on: the comet picks it up where it started and carries it to "now" */
  ongoing?: boolean;
  /** For something that has ended ("Mar 2027"): the comet drops it off there */
  until?: string;
}

const events = await fetchData<TimelineEvent[]>('timeline.json');

const planet: Record<string, string> = {
  education: 'bg-accent-light shadow-accent-light/50',
  work: 'bg-emerald-400 shadow-emerald-400/50',
  milestone: 'bg-zinc-400 shadow-zinc-400/40',
  graduation: 'bg-amber-400 shadow-amber-400/50',
};
const tone: Record<string, { bg: string; border: string; hex: string }> = {
  education: { bg: 'bg-accent-light', border: 'border-accent-light', hex: '#a78bfa' },
  work: { bg: 'bg-emerald-400', border: 'border-emerald-400', hex: '#34d399' },
  milestone: { bg: 'bg-zinc-400', border: 'border-zinc-400', hex: '#a1a1aa' },
  graduation: { bg: 'bg-amber-400', border: 'border-amber-400', hex: '#fbbf24' },
};
const toneOf = (e: TimelineEvent) => tone[e.type] ?? tone.milestone;

const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
// "Jul 2024" → 2024.5; undated ("Present") sorts after everything
const dateValue = (label: string) => {
  const year = label.match(/\d{4}/)?.[0];
  if (!year) return Infinity;
  const month = MONTHS.indexOf(label.trim().slice(0, 3).toLowerCase());
  return Number(year) + (month >= 0 ? month / 12 : 0);
};

const hasDate = (e: TimelineEvent) => /\d{4}/.test(e.year);
const isCurrent = (e: TimelineEvent) => !e.until && (e.ongoing || !hasDate(e));
const isRange = (e: TimelineEvent) => hasDate(e) && (!!e.until || !!e.ongoing);

// "Now" lists everything still going on, most recently started first (undated ones on top)
const current = events.filter(isCurrent).sort((a, b) => dateValue(b.year) - dateValue(a.year));

// The path, newest first: plain events, plus a start marker for every range and an end marker for ranges that ended
type Station = { kind: 'event' | 'start' | 'end'; e: TimelineEvent; id: number; date: number };
const stations: Station[] = events.flatMap((e, id): Station[] => {
  if (!hasDate(e)) return [];
  if (!isRange(e)) return [{ kind: 'event', e, id, date: dateValue(e.year) }];
  const start: Station = { kind: 'start', e, id, date: dateValue(e.year) };
  return e.until ? [start, { kind: 'end', e, id, date: dateValue(e.until) }] : [start];
}).sort((a, b) => b.date - a.date);

// Each row is pushed sideways along an arc (right → left → right), so the curve drawn
// through the dots reads as a trajectory rising towards "now"
const rows = (current.length ? 1 : 0) + stations.length;
const offsetAt = (i: number) => {
  const t = rows > 1 ? i / (rows - 1) : 0;
  return ((1 - Math.sin(Math.PI * t)) * (1 - 0.45 * t)).toFixed(3);
};
const stationOffset = current.length ? 1 : 0;

// One moon per current thing; dated ones are the ranges the comet carries up (matched by index into events)
const moons = current.map(e => ({ range: hasDate(e) ? events.indexOf(e) : null, color: toneOf(e).hex }));
---

<section id="timeline" class="py-20 md:py-28 px-5">
  <div class="page-container">
    <SectionHeader eyebrow="Journey" title="How I <em class='text-accent-light'>got here</em>" />

    <ol id="trajectory" class="relative [--amp:1.75rem] md:[--amp:min(34vw,32rem)]" data-moons={JSON.stringify(moons)}>
      <svg id="traj-svg" class="absolute inset-0 w-full h-full overflow-visible pointer-events-none" aria-hidden="true">
        <defs>
          <linearGradient id="traj-gradient" x1="0" y1="1" x2="0" y2="0">
            <stop offset="0" stop-color="#3f3f46" stop-opacity="0.4" />
            <stop offset="1" stop-color="#a78bfa" stop-opacity="0.9" />
          </linearGradient>
          <radialGradient id="now-glow">
            <stop offset="0" stop-color="#c4b5fd" />
            <stop offset="0.55" stop-color="#8b5cf6" />
            <stop offset="1" stop-color="#6d28d9" />
          </radialGradient>
        </defs>
        <path id="traj-path" d="" fill="none" stroke="url(#traj-gradient)" stroke-width="1.5" stroke-dasharray="4 6" />
        <!-- Depth order: trails, moons behind the planet, the planet, moons in front, comet, flashes -->
        <g id="layer-trails"></g>
        <g id="layer-back"></g>
        <circle id="now-planet" r="9" fill="url(#now-glow)" class="drop-shadow-[0_0_10px_rgba(167,139,250,0.7)]" opacity="0" />
        <g id="layer-front"></g>
        <g id="layer-fx"></g>
      </svg>

      {current.length > 0 && (
        <li class="reveal relative pb-14" style={`padding-left: calc(${offsetAt(0)} * var(--amp) + 3.5rem)`}>
          <!-- Anchor for the "now" planet, which is drawn in the SVG so moons can pass behind and in front of it -->
          <span class="traj-dot now-dot absolute top-0 w-5 h-5 -ml-1 rounded-full opacity-0" style={`left: calc(${offsetAt(0)} * var(--amp))`} />

          <p class="font-mono text-[11px] uppercase tracking-widest text-accent-light mb-3">Now</p>
          <div class="grid gap-6">
            {current.map(e => (
              <article>
                <h3 class="flex items-center gap-2.5 text-zinc-50 font-medium text-lg leading-snug">
                  <span class={`w-1.5 h-1.5 shrink-0 rounded-full ${toneOf(e).bg}`} />
                  {e.title}
                </h3>
                <p class="font-mono text-xs text-zinc-500 mb-2 pl-4">
                  {e.place}{hasDate(e) && <span class="text-zinc-600"> · since {e.year}</span>}
                </p>
                <p class="text-sm text-zinc-400 leading-relaxed max-w-md pl-4">{e.description}</p>
              </article>
            ))}
          </div>
        </li>
      )}

      {stations.map((st, i) => {
        const { e } = st;
        const x = offsetAt(i + stationOffset);
        const pad = `padding-left: calc(${x} * var(--amp) + 2.25rem)`;
        const left = `left: calc(${x} * var(--amp))`;
        if (st.kind === 'event') return (
          <li class="reveal relative pb-10 last:pb-0" style={pad}>
            <span class={`traj-dot absolute top-1 w-3 h-3 rounded-full shadow-[0_0_14px] ${planet[e.type] ?? 'bg-zinc-500'}`} style={left} />
            <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500 mb-1">{e.year}</p>
            <h3 class="text-zinc-50 font-medium text-lg leading-snug">{e.title}</h3>
            <p class="font-mono text-xs text-zinc-500 mb-2">{e.place}</p>
            <p class="text-sm text-zinc-400 leading-relaxed max-w-md">{e.description}</p>
          </li>
        );
        // Start / end of something that spans time: the comet picks the body up at the start
        // and sets it down at the end — the dashed ring marks where it was or will land
        const ended = st.kind === 'end';
        return (
          <li class="reveal relative pb-10 last:pb-0" style={pad}>
            {ended ? (
              <span class={`traj-dot absolute top-1 w-3 h-3 rounded-full border border-dashed ${toneOf(e).border}`} style={left} data-range={st.id} data-kind="end" />
            ) : (
              <>
                <span class={`ghost absolute top-1 w-3 h-3 rounded-full border border-dashed border-zinc-600 opacity-0 transition-opacity duration-500`} style={left} />
                <span
                  class={`traj-dot absolute top-1 w-3 h-3 rounded-full shadow-[0_0_14px] ${planet[e.type] ?? 'bg-zinc-500'}`}
                  style={left}
                  data-range={st.id}
                  data-kind="start"
                  data-color={toneOf(e).hex}
                />
              </>
            )}
            <p class="font-mono text-[11px] uppercase tracking-widest text-zinc-500">
              {ended ? e.until : e.year} <span class="text-zinc-600">· {ended ? 'ended' : 'started'}</span>
            </p>
            {ended ? (
              <>
                <h3 class="text-zinc-50 font-medium text-lg leading-snug">{e.title}</h3>
                <p class="font-mono text-xs text-zinc-500 mb-2">{e.place} · {e.year} – {e.until}</p>
                <p class="text-sm text-zinc-400 leading-relaxed max-w-md">{e.description}</p>
              </>
            ) : (
              <p class="text-sm text-zinc-400">
                {e.title} <span class="text-zinc-600">{e.until ? `↑ until ${e.until}` : '↑ still going'}</span>
              </p>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const list = document.getElementById('trajectory')!;
  const path = document.getElementById('traj-path') as unknown as SVGPathElement;
  const planetEl = document.getElementById('now-planet') as unknown as SVGCircleElement;
  const layer = (id: string) => document.getElementById(id) as unknown as SVGGElement;
  const trails = layer('layer-trails'), back = layer('layer-back'), front = layer('layer-front'), fx = layer('layer-fx');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const moonSpecs: { range: number | null; color: string }[] = JSON.parse(list.dataset.moons ?? '[]');

  // Orbits are circles in a tilted plane, seen from slightly above
  const TILT = 0.5;
  // Tighter on phones, where the text sits close to the planet
  const SCALE = matchMedia('(max-width: 767px)').matches ? 0.6 : 1;
  const GAP = 14;                 // px along the path between the probe and each body it tows
  const HANDOVER = 46 * SCALE;    // px before "now" where the probe swings into orbit
  const SPRING = 110, SPRING_DAMP = 13;   // towing: slightly under-damped, bodies swing a little
  const EASE = 0.7;               // s — how quickly dropped bodies settle onto their own orbit

  // Moon k: radius and period grow outward, like a real system
  const orbitFor = (k: number) => ({ R: (22 + k * 9) * SCALE, period: 6 + k * 3.5 });
  const PROBE_R = orbitFor(moonSpecs.length).R + 6 * SCALE;
  const PROBE_PERIOD = 3.4;       // s for the probe's single lap

  type Vec = { x: number; y: number };
  // Polar position in the orbit plane around "now"
  type Orbit = { rho: number; theta: number; R: number; omega: number; omegaTarget: number };
  type Body = {
    el: SVGCircleElement; trail: SVGCircleElement[]; hist: Vec[];
    mode: 'hidden' | 'towed' | 'landing' | 'orbit';
    p: Vec; v: Vec; o: Orbit;
  };
  type Range = { id: number; dot: HTMLElement; ghost: HTMLElement | null; startAt: number; endAt: number | null; end: Vec | null; body: Body; order: number; moon: number };

  let length = 0;
  let now: Vec = { x: 0, y: 0 };
  let ranges: Range[] = [];
  const moons: Body[] = [];
  const pulses: { el: SVGCircleElement; t0: number }[] = [];

  const circle = (parent: SVGGElement, r: number, fill: string) => {
    const c = document.createElementNS(SVG_NS, 'circle');
    c.setAttribute('r', `${r}`);
    c.setAttribute('fill', fill);
    c.setAttribute('opacity', '0');
    parent.appendChild(c);
    return c;
  };
  const put = (c: SVGCircleElement, p: Vec, opacity = 1) => {
    c.setAttribute('cx', p.x.toFixed(2));
    c.setAttribute('cy', p.y.toFixed(2));
    c.setAttribute('opacity', opacity.toFixed(3));
  };
  // Plain {x, y}: a DOMPoint's coordinates are getters and get lost when the point is copied with {...p}
  const at = (s: number): Vec => {
    const q = path.getPointAtLength(Math.min(Math.max(s, 0), length));
    return { x: q.x, y: q.y };
  };
  const fromOrbit = (rho: number, theta: number): Vec => ({ x: now.x + Math.cos(theta) * rho, y: now.y + Math.sin(theta) * rho * TILT });
  const toOrbit = (p: Vec) => {
    const x = p.x - now.x, z = (p.y - now.y) / TILT;
    return { rho: Math.hypot(x, z), theta: Math.atan2(z, x) };
  };
  const approach = (value: number, target: number, dt: number, tau: number) => value + (target - value) * (1 - Math.exp(-dt / tau));

  function makeBody(color: string, size = 3): Body {
    const trail = Array.from({ length: 7 }, (_, i) => circle(trails, size * 0.8 * (1 - i / 9), color));
    const el = circle(front, size, color);
    el.style.filter = `drop-shadow(0 0 4px ${color})`;
    return { el, trail, hist: [], mode: 'hidden', p: { x: 0, y: 0 }, v: { x: 0, y: 0 }, o: { rho: 0, theta: 0, R: 0, omega: 0, omegaTarget: 0 } };
  }

  moonSpecs.forEach((spec, k) => {
    const body = makeBody(spec.color);
    const { R, period } = orbitFor(k);
    const omega = (2 * Math.PI) / period;
    body.o = { rho: R, theta: k * 2.3, R, omega, omegaTarget: omega };
    // Undated things (e.g. "Physics student") have always been here; carried ones arrive with the probe
    if (spec.range === null || reduced) body.mode = 'orbit';
    moons.push(body);
  });

  const probe = makeBody('#fde68a', 3.5);
  probe.el.style.filter = 'drop-shadow(0 0 6px #fbbf24)';
  probe.trail.forEach((c) => c.setAttribute('fill', '#fbbf24'));

  // offsetLeft/offsetTop ignore transforms, so the reveal animation doesn't skew the measurement
  const centre = (dot: HTMLElement): Vec => {
    const li = dot.parentElement!;
    return { x: li.offsetLeft + dot.offsetLeft + dot.offsetWidth / 2, y: li.offsetTop + dot.offsetTop + dot.offsetHeight / 2 };
  };
  const lengthAt = (p: Vec) => {
    let best = 0, bestDist = Infinity;
    for (let s = 0; s <= length; s += 2) {
      const q = path.getPointAtLength(s);
      const d = (q.x - p.x) ** 2 + (q.y - p.y) ** 2;
      if (d < bestDist) { bestDist = d; best = s; }
    }
    return best;
  };

  // Smooth curve through the dot centres (Catmull-Rom → cubic Bézier), oldest first so the probe climbs
  function layout() {
    const dots = [...list.querySelectorAll<HTMLElement>('.traj-dot')].reverse();
    const pts = dots.map(centre);
    if (pts.length < 2) return;
    let d = `M ${pts[0].x} ${pts[0].y}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] ?? pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
      d += ` C ${p1.x + (p2.x - p0.x) / 6} ${p1.y + (p2.y - p0.y) / 6}, ${p2.x - (p3.x - p1.x) / 6} ${p2.y - (p3.y - p1.y) / 6}, ${p2.x} ${p2.y}`;
    }
    path.setAttribute('d', d);
    length = path.getTotalLength();
    now = pts[pts.length - 1];
    put(planetEl, now);

    const previous = new Map(ranges.map((r) => [r.id, r]));
    const found = new Map<number, Range>();
    for (const dot of dots.filter((el) => el.dataset.range !== undefined)) {
      const id = Number(dot.dataset.range);
      const moon = moonSpecs.findIndex((m) => m.range === id);
      const range = found.get(id) ?? previous.get(id) ?? {
        id, dot, ghost: null, startAt: 0, endAt: null, end: null, order: 0, moon,
        body: moons[moon] ?? makeBody(dot.dataset.color ?? '#a1a1aa'),
      };
      if (dot.dataset.kind === 'end') { range.endAt = lengthAt(centre(dot)); range.end = centre(dot); }
      else { range.dot = dot; range.ghost = dot.parentElement!.querySelector('.ghost'); range.startAt = lengthAt(centre(dot)); }
      found.set(id, range);
    }
    ranges = [...found.values()];
    if (reduced) settle();
  }

  // Static end state for reduced motion: everything already where it belongs
  function settle() {
    for (const r of ranges) {
      r.dot.style.opacity = '0';
      if (r.ghost) r.ghost.style.opacity = '1';
      if (r.end) { r.body.mode = 'landing'; r.body.p = { ...r.end }; }
    }
    for (const m of moons) m.p = fromOrbit(m.o.rho, m.o.theta);
    renderBodies();
  }

  // --- Mission ------------------------------------------------------------------------------
  // flying:   the probe climbs the path, picking up whatever started along the way
  // orbiting: one lap around "now", setting each carried body onto its own orbit
  // landing:  the probe spirals down onto the planet and is gone
  let phase: 'idle' | 'flying' | 'orbiting' | 'landing' | 'done' = 'idle';
  let flightStart = 0, landStart = 0, lap = 0, towed = 0;
  const probeOrbit = { rho: 0, theta: 0, omega: 0, sgn: 1 };

  function pulse(p: Vec, color: string, time: number) {
    const el = circle(fx, 3, 'none');
    el.setAttribute('stroke', color);
    el.setAttribute('stroke-width', '1.2');
    put(el, p);
    pulses.push({ el, t0: time });
  }

  function reset() {
    phase = 'idle';
    towed = 0;
    lap = 0;
    for (const r of ranges) {
      r.dot.style.opacity = '1';
      if (r.ghost) r.ghost.style.opacity = '0';
      r.body.mode = 'hidden';
      r.body.hist = [];
    }
    probe.mode = 'hidden';
    probe.hist = [];
  }

  function stepSpring(b: Body, target: Vec, dt: number) {
    b.v.x += (SPRING * (target.x - b.p.x) - SPRING_DAMP * b.v.x) * dt;
    b.v.y += (SPRING * (target.y - b.p.y) - SPRING_DAMP * b.v.y) * dt;
    b.p.x += b.v.x * dt;
    b.p.y += b.v.y * dt;
  }

  // Glide from wherever it is onto its own circular orbit — radius and speed ease in, no overshoot
  function stepOrbit(b: Body, dt: number) {
    const o = b.o;
    o.rho = approach(o.rho, o.R, dt, EASE);
    o.omega = approach(o.omega, o.omegaTarget, dt, EASE);
    o.theta += o.omega * dt;
    b.p = fromOrbit(o.rho, o.theta);
  }

  // Set a carried body loose around "now", continuing the probe's motion
  function deploy(r: Range, time: number) {
    const b = r.body;
    const { R, period } = orbitFor(r.moon);
    const { rho, theta } = toOrbit(b.p);
    b.o = { rho, theta, R, omega: probeOrbit.omega, omegaTarget: (probeOrbit.sgn * 2 * Math.PI) / period };
    b.mode = 'orbit';
    pulse(b.p, r.dot.dataset.color ?? '#fff', time);
  }

  const towedRanges = () => ranges.filter((r) => r.body.mode === 'towed').sort((a, b) => b.order - a.order);

  function update(time: number, dt: number) {
    if (phase === 'flying') {
      // Slow start at the first station, steady climb, then a gentle approach before orbit insertion
      const q = Math.min(Math.max((time - flightStart) / Math.min(Math.max(length * 6, 6500), 11000), 0), 1);
      const eased = q < 0.5 ? 2 * q * q : 1 - (-2 * q + 2) ** 2 / 2;
      const s = eased * (length - HANDOVER);
      probe.mode = 'towed';
      probe.p = at(s);

      for (const r of ranges) {
        const b = r.body;
        if (b.mode === 'hidden' && s >= r.startAt) {
          // Pick-up: the body leaves its station and a dashed ring stays behind
          b.mode = 'towed';
          b.p = centre(r.dot);
          b.v = { x: 0, y: 0 };
          r.order = towed++;
          r.dot.style.opacity = '0';
          if (r.ghost) r.ghost.style.opacity = '1';
          pulse(b.p, r.dot.dataset.color ?? '#fff', time);
        }
      }
      // Most recently collected rides right behind the probe; never pulled back below its station
      towedRanges().forEach((r, rank) => {
        const along = Math.max(s - GAP * (rank + 1), r.startAt);
        if (r.endAt !== null && along >= r.endAt) { r.body.mode = 'landing'; return; }
        stepSpring(r.body, at(along), dt);
      });

      if (q >= 1) {
        // Orbit insertion: keep the probe where it is and turn its motion into a lap around "now"
        const { rho, theta } = toOrbit(probe.p);
        const a = toOrbit(at(length - HANDOVER - 4)), sgn = Math.sign(Math.sin(theta - a.theta)) || 1;
        Object.assign(probeOrbit, { rho, theta, sgn, omega: (sgn * 2 * Math.PI) / PROBE_PERIOD });
        phase = 'orbiting';
        lap = 0;
      }
    } else if (phase === 'orbiting' || phase === 'landing') {
      const target = phase === 'orbiting' ? PROBE_R : 3;
      probeOrbit.rho = approach(probeOrbit.rho, target, dt, phase === 'orbiting' ? 0.35 : 0.3);
      probeOrbit.theta += probeOrbit.omega * dt;
      lap += Math.abs(probeOrbit.omega) * dt;
      probe.p = fromOrbit(probeOrbit.rho, probeOrbit.theta);

      // Towed bodies follow on the probe's orbit, a little behind; each is dropped at its share of the lap
      const carried = towedRanges();
      carried.forEach((r, rank) => {
        const lag = probeOrbit.theta - probeOrbit.sgn * 0.45 * (rank + 1);
        stepSpring(r.body, fromOrbit(probeOrbit.rho, lag), dt);
      });
      const total = carried.length + ranges.filter((r) => r.body.mode === 'orbit' && r.moon >= 0).length;
      const dropped = total - carried.length;
      if (carried.length && lap >= ((dropped + 1) / (total + 1)) * 2 * Math.PI) deploy(carried[carried.length - 1], time);

      if (phase === 'orbiting' && lap >= 2 * Math.PI && !carried.length) { phase = 'landing'; landStart = time; }
      if (phase === 'landing' && time - landStart > 900) {
        phase = 'done';
        probe.mode = 'hidden';
        pulse(now, '#fde68a', time);
      }
    }

    for (const r of ranges) if (r.body.mode === 'landing' && r.end) stepSpring(r.body, r.end, dt);
    for (const m of moons) if (m.mode === 'orbit') stepOrbit(m, dt);

    for (let i = pulses.length - 1; i >= 0; i--) {
      const q = (time - pulses[i].t0) / 700;
      if (q >= 1) { pulses[i].el.remove(); pulses.splice(i, 1); continue; }
      pulses[i].el.setAttribute('r', `${3 + 22 * q}`);
      pulses[i].el.setAttribute('opacity', `${0.7 * (1 - q)}`);
    }
  }

  function renderBodies() {
    const bodies = new Set([...moons, ...ranges.map((r) => r.body), probe]);
    for (const b of bodies) {
      const shown = b.mode !== 'hidden';
      if (shown) { b.hist.push({ ...b.p }); if (b.hist.length > 28) b.hist.shift(); }
      // Anything on the far side of the planet passes behind it
      const circling = b.mode === 'orbit' || (b === probe && (phase === 'orbiting' || phase === 'landing')) || (b.mode === 'towed' && phase === 'orbiting');
      const behind = circling && b.p.y < now.y;
      const want = behind ? back : front;
      if (b.el.parentNode !== want) want.appendChild(b.el);
      const fade = b === probe && phase === 'landing' ? Math.max(0, 1 - (performance.now() - landStart) / 900) : 1;
      put(b.el, b.p, shown ? fade : 0);
      b.trail.forEach((c, i) => {
        const h = b.hist[b.hist.length - 1 - (i + 1) * 3];
        if (h && shown && !reduced) put(c, h, 0.35 * fade * (1 - i / b.trail.length)); else c.setAttribute('opacity', '0');
      });
    }
  }

  // --- Loop ---------------------------------------------------------------------------------
  // Fixed physics steps, catching up on dropped frames, so the motion is the same at any frame rate
  const STEP = 1 / 120;
  let visible = false, last = 0, pending = 0;
  function frame(time: number) {
    pending = Math.min(pending + (time - (last || time)) / 1000, 0.25);
    last = time;
    if (visible && length) {
      const steps = Math.floor(pending / STEP);
      for (let i = 0; i < steps; i++) update(time - (steps - 1 - i) * STEP * 1000, STEP);
      pending -= steps * STEP;
      renderBodies();
    } else {
      pending = 0;
    }
    requestAnimationFrame(frame);
  }

  new ResizeObserver(layout).observe(list);
  document.fonts?.ready.then(layout);
  layout();

  if (reduced) {
    settle();
  } else {
    // Animate only while the list is on screen; start over once it has been left completely
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (!e.isIntersecting && phase !== 'idle') reset();
    }).observe(list);
    // Launch when the oldest station — where the probe starts — comes into view
    // (the list can be taller than the screen, so a share-of-list threshold would never fire on phones)
    const launchPad = list.lastElementChild;
    if (launchPad) new IntersectionObserver(([e]) => {
      if (e.isIntersecting && phase === 'idle') {
        phase = 'flying';
        flightStart = performance.now() + 300;
      }
    }, { threshold: 0.6 }).observe(launchPad);
    requestAnimationFrame(frame);
  }
</script>
